# 运行时产物
logs/*
!logs/.htaccess
!logs/cache/.gitkeep
!logs/nonce/.gitkeep
# 注意：logs/.htaccess、logs/cache/.gitkeep、logs/nonce/.gitkeep 必须真实提交，
# 否则分发包没有 logs 目录骨架，安装器 is_writable 检查直接失败
install/install.lock
yanzheng_blank.zip

# 运行时生成的密钥与数据
config/grace_keys.php
data/file_baseline.json
data/backups/*
!data/backups/.gitkeep

# ------------------------------------------------------------------
# 下列内容属于「作者本地工具」或「只随发行包交付」，不进公开仓库。
# 注意：它们仍然留在工作区，因此仍会被 deploy/make_release.php 打进
# 发行包（打包走 scandir 遍历文件系统，不看 git 索引）。
# ------------------------------------------------------------------
# 内部契约测试（含本地后台目录名、本机路径），使用者不需要
tests/
# 发版打包脚本，作者本地工具
deploy/
# CI 流水线导出
.workflow/
# 运维手册：运营者视角，已发布于官网文档中心，随发行包交付即可
docs/OPS.md
# 已废弃 3.0 信封的报文留档：3.1.3 服务端直接拒绝，对使用者零价值
docs/API_RAW_EXAMPLES.md

# 用户上传文件
uploads/shop/*
uploads/web/*
!uploads/shop/.gitkeep
!uploads/web/.gitkeep

# 升级 / 迁移脚本（不随分发包提供）
install/migrate_*.php

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.catpaw/
.freebuff/
.workbuddy/

# 临时文件
*.log
*.tmp
*~

# 打包工作目录与产物
_pkg/
*.zip
# 注：releases/ 下的发行包一律不入库（含 NebulaSealClient.zip，114MB，
# 超出 GitHub 单文件 100MB 上限，且二进制本就该走 Releases 而非源码树）

# SDK 编译产物
sdk/build/out/
*.obj
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.dll
# 例外：随 SDK 分发的加固工具静态库
!sdk/vmp/*.lib

# SDK 发行版随仓库发布（2026-10-04 起）
# /sdk/        ← 已在 yanzheng 主仓库发布
# /sdk-py/     ← Python SDK
# /sdk-c#/     ← C# SDK  
# /sdk-c++/    ← C++ SDK（header-only）

# 响应签名私钥（2026-10-03 审计：绝不入库）
config/resp_sign_keys.php

# Python
__pycache__/
*.pyc


# 官网门户独立仓库维护（gitee.com/xinia/online-version-verification），不入主仓库
update-system/
